# Copy to /opt/shop/.env on the server. Never commit the real file.
GITHUB_REPOSITORY=your-github-user/your-repo   # must be lowercase
DB_USER=shop
DB_PASSWORD=change-me
APP_SESSION_COOKIE_SECURE=true
APP_SESSION_COOKIE_SAME_SITE=Lax
APP_CORS_ORIGIN=http://YOUR_SERVER_IP
# First admin account, created on first start. Change the password after logging in. Leave APP_ADMIN_EMAIL blank to skip.
APP_ADMIN_EMAIL=admin@yourdomain.com
APP_ADMIN_PASSWORD=change-me-now
# Optional demo seller that owns the sample products (leave blank in production).
APP_SELLER_EMAIL=
APP_SELLER_PASSWORD=
# Optional second demo seller (3% commission) and the default commission percent for new sellers.
APP_SELLER2_EMAIL=
APP_SELLER2_PASSWORD=
APP_COMMISSION_DEFAULT=5
# Optional private S3 storage for product images. Set true and use an existing bucket.
APP_S3_ENABLED=true
APP_S3_BUCKET=bazario-app
APP_S3_REGION=ap-south-1
APP_S3_UPLOAD_URL_EXPIRATION_SECONDS=300
APP_S3_READ_URL_EXPIRATION_SECONDS=3600
